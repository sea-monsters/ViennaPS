+      status = levelSetUpdateExecutor(context, output, executorError);
+    } catch (const std::exception &exception) {
+      executorError = exception.what();
+    } catch (...) {
+      executorError = "unknown exception";
+    }
+
+    if (status == LevelSetUpdateStatus::FALLBACK)
+      return false;
+
+    bool validOutput = status == LevelSetUpdateStatus::HANDLED &&
+                       output.values.size() == topDomain.getNumberOfSegments();
+    if (saveAdvectionVelocities) {
+      validOutput =
+          validOutput &&
+          output.velocities.size() == topDomain.getNumberOfSegments() &&
+          output.dissipations.size() == topDomain.getNumberOfSegments();
+    }
+
+    for (unsigned p = 0; validOutput && p < topDomain.getNumberOfSegments();
+         ++p) {
+      const auto pointCount = topDomain.getDomainSegment(p).getNumberOfPoints();
+      validOutput = output.values[p].size() == pointCount;
+      if (saveAdvectionVelocities) {
+        validOutput = validOutput &&
+                      output.velocities[p].size() == pointCount &&
+                      output.dissipations[p].size() == pointCount;
+      }
+      for (const auto value : output.values[p])
+        validOutput = validOutput && std::isfinite(value);
+      if (saveAdvectionVelocities) {
+        for (const auto velocity : output.velocities[p])
+          validOutput = validOutput && std::isfinite(velocity);
+        for (const auto dissipation : output.dissipations[p])
+          validOutput = validOutput && std::isfinite(dissipation);
+      }
