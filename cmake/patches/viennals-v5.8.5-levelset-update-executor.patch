+    typename PointData<T>::ScalarDataType dissipations;
+    if (saveAdvectionVelocities) {
+      for (unsigned p = 0; p < output.velocities.size(); ++p) {
+        velocities.insert(velocities.end(),
+                          std::make_move_iterator(output.velocities[p].begin()),
+                          std::make_move_iterator(output.velocities[p].end()));
+        dissipations.insert(
