+      topDomain.getDomainSegment(p).definedValues = std::move(output.values[p]);
+    }
+    if (saveAdvectionVelocities) {
+      auto &pointData = levelSets.back()->getPointData();
+      pointData.insertReplaceScalarData(std::move(velocities), velocityLabel);
+      pointData.insertReplaceScalarData(std::move(dissipations),
+                                        dissipationLabel);
+    }
+    return true;
+  }
