+            std::make_move_iterator(output.dissipations[p].begin()),
+            std::make_move_iterator(output.dissipations[p].end()));
+      }
+    }
+
+    for (unsigned p = 0; p < topDomain.getNumberOfSegments(); ++p) {
+      topDomain.getDomainSegment(p).definedValues = std::move(output.values[p]);
